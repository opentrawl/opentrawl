#!/usr/bin/env bash
# Build every bundled first-party standalone trawler plugin executable
# (trawlers/*/cmd/trawl-*) into --output-dir.
set -euo pipefail

usage() {
  echo "usage: scripts/build-bundled-plugins --output-dir DIR [--arch ARCH] [--trimpath]" >&2
  exit 2
}

output_dir=""
target_arch=""
use_trimpath=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --output-dir) output_dir="${2:-}"; shift 2 ;;
    --arch) target_arch="${2:-}"; shift 2 ;;
    --trimpath) use_trimpath=1; shift ;;
    *) usage ;;
  esac
done

[[ -n "$output_dir" ]] || usage

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
mkdir -p "$output_dir"

export CGO_ENABLED=1
export GOFLAGS="${GOFLAGS:--tags=sqlite_fts5}"

build_args=()
if [[ "$use_trimpath" -eq 1 ]]; then
  build_args+=(-trimpath)
fi
if [[ -n "$target_arch" ]]; then
  export GOARCH="$target_arch"
fi

while IFS= read -r target_dir; do
  if [[ -z "$(find "$target_dir" -maxdepth 1 -name '*.go' -print -quit)" ]]; then
    continue
  fi
  plugin_name="$(basename "$target_dir")"
  module_dir="$(dirname "$(dirname "$target_dir")")"
  (
    cd "$module_dir"
    go build ${build_args[@]+"${build_args[@]}"} -o "$output_dir/$plugin_name" "./cmd/$plugin_name"
  )
done < <(find "$repo_root/trawlers" -mindepth 3 -maxdepth 3 -type d -path '*/cmd/trawl-*' | sort)
