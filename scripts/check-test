#!/usr/bin/env bash
set -euo pipefail

root=$(git rev-parse --show-toplevel)
cd "$root"

# Exact-output fixtures render local times. Pin the test process so their
# contract is independent of the developer or CI runner's timezone.
export TZ=Europe/Amsterdam

modules=()
while IFS= read -r module; do
  modules+=("$module")
done < <(
  git ls-files |
    sed -n -e 's#^go\.mod$#.#p' -e 's#/go\.mod$##p' |
    sort
)

for module in "${modules[@]}"; do
  echo "test: $module"
  (
    cd "$root/$module"
    go test -p=2 ./...
  )
done

swift_test_args=()
if [[ -n "${OPENTRAWL_SWIFT_SCRATCH_PATH:-}" ]]; then
  swift_test_args+=(--scratch-path "$OPENTRAWL_SWIFT_SCRATCH_PATH")
elif [[ "${GITHUB_ACTIONS:-}" != "true" && "$(uname -s)" == "Darwin" ]]; then
  export OPENTRAWL_SWIFT_SCRATCH_PATH="$HOME/Library/Developer/OpenTrawl/DerivedData"
  swift_test_args+=(--scratch-path "$OPENTRAWL_SWIFT_SCRATCH_PATH")
fi

if [[ "${GITHUB_ACTIONS:-}" == "true" ]]; then
  export OPENTRAWL_SKIP_WINDOW_FOCUS_TESTS=1
fi

if [[ "${OPENTRAWL_SWIFT_SCRATCH_PATH:-}" == "$HOME/Library/Developer/OpenTrawl/DerivedData" && "${OPENTRAWL_DEVELOPMENT_BUILD_LOCK_HELD:-}" != "1" ]]; then
  mkdir -p "$HOME/Library/Developer/OpenTrawl"
  OPENTRAWL_DEVELOPMENT_BUILD_LOCK_HELD=1 /usr/bin/lockf -k "$HOME/Library/Developer/OpenTrawl/build.lock" \
    /usr/bin/env bash -euo pipefail -c '
      cd "$1"
      echo "test: generated app protobufs"
      app/scripts/generate-app-protobuf --check
      echo "test: app"
      app/scripts/swift-with-trawl test --scratch-path "$2" --no-parallel
    ' _ "$root" "$OPENTRAWL_SWIFT_SCRATCH_PATH"
else
  echo "test: generated app protobufs"
  app/scripts/generate-app-protobuf --check
  echo "test: app"
  app/scripts/swift-with-trawl test ${swift_test_args[@]+"${swift_test_args[@]}"} --no-parallel
fi

echo "check-test: ok"
