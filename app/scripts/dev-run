#!/usr/bin/env bash
set -euo pipefail

app_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
script_path="$app_dir/scripts/dev-run"
repo_root="$(cd "$app_dir/.." && pwd)"
build_root="$app_dir/build"
app="$build_root/OpenTrawl.app"
contents="$app/Contents"
swift_scratch="${OPENTRAWL_SWIFT_SCRATCH_PATH:-$app_dir/.build}"
identity="OpenTrawl Dev Signing"
keychain="opentrawl-dev.keychain"
pass_file="${XDG_CONFIG_HOME:-$HOME/.config}/opentrawl/dev-keychain-pass"
photos_entitlements="$app_dir/OpenTrawl.entitlements"
dev_entitlements="$build_root/dev-entitlements.plist"
version="0.1.0"
deployment_target="26.0"
launch=1
candidate_name=""
development_builds_root="$HOME/Library/Developer/OpenTrawl"
development_builds_directory="$development_builds_root/Builds"
original_arguments=("$@")
temporary_paths=()

cleanup_temporary_paths() {
  for path in "${temporary_paths[@]}"; do
    [[ ! -e "$path" ]] || trash "$path"
  done
}
trap cleanup_temporary_paths EXIT

while [[ $# -gt 0 ]]; do
  case "$1" in
    --build-only)
      launch=0
      shift
      ;;
    --candidate)
      [[ -n "${2:-}" ]] || {
        echo "dev-run: --candidate requires a name" >&2
        exit 2
      }
      candidate_name="$2"
      shift 2
      ;;
    *)
      echo "usage: app/scripts/dev-run [--build-only] [--candidate NAME]" >&2
      exit 2
      ;;
  esac
done

if [[ -n "$candidate_name" ]]; then
  [[ "$candidate_name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || {
    echo "dev-run: candidate name must start with a letter or number and may also contain dots, dashes and underscores" >&2
    exit 2
  }
  candidate_directory="$development_builds_directory/$candidate_name"
  candidate_app="$candidate_directory/OpenTrawl.app"
  [[ ! -e "$candidate_directory" && ! -L "$candidate_directory" ]] || {
    echo "dev-run: candidate already exists: $candidate_app" >&2
    exit 1
  }
fi

mkdir -p "$development_builds_directory"
if [[ "${OPENTRAWL_DEVELOPMENT_BUILD_LOCK_HELD:-}" != "1" ]]; then
  exec env OPENTRAWL_DEVELOPMENT_BUILD_LOCK_HELD=1 \
    /usr/bin/lockf -k "$development_builds_root/build.lock" \
    "$script_path" "${original_arguments[@]}"
fi

contents="$app/Contents"

commit="$(git -C "$repo_root" rev-parse HEAD)"
dirty=false
if [[ -n "$(git -C "$repo_root" status --porcelain)" ]]; then
  dirty=true
fi

echo "Building the Mac app"
host_swift() {
  env -u SDKROOT -u DEVELOPER_DIR -u MACOSX_DEPLOYMENT_TARGET swift "$@"
}
host_swift build --package-path "$app_dir" --scratch-path "$swift_scratch" --configuration debug
swift_bin="$(host_swift build --package-path "$app_dir" --scratch-path "$swift_scratch" --configuration debug --show-bin-path)"

if [[ -n "$candidate_name" ]]; then
  staging_root="$(mktemp -d "$development_builds_directory/.opentrawl-build.XXXXXX")"
  temporary_paths+=("$staging_root")
  app="$staging_root/OpenTrawl.app"
  contents="$app/Contents"
else
  [[ ! -e "$app" ]] || trash "$app"
fi
mkdir -p "$contents/MacOS" "$contents/Helpers" "$contents/Frameworks" "$contents/Resources"
cp "$swift_bin/OpenTrawlApp" "$contents/MacOS/OpenTrawlApp"

echo "Building the bundled CLI"
go_command=(
  env
  -u SDKROOT
  -u DEVELOPER_DIR
  -u NIX_APPLE_SDK_VERSION
  -u NIX_ENFORCE_NO_NATIVE
  -u NIX_CFLAGS_COMPILE
  -u NIX_LDFLAGS
  CC=/usr/bin/clang
  CXX=/usr/bin/clang++
  go
)
if ! command -v go >/dev/null; then
  go_command=(
    devenv shell --
    env
    -u SDKROOT
    -u DEVELOPER_DIR
    -u NIX_APPLE_SDK_VERSION
    -u NIX_ENFORCE_NO_NATIVE
    -u NIX_CFLAGS_COMPILE
    -u NIX_LDFLAGS
    CC=/usr/bin/clang
    CXX=/usr/bin/clang++
    go
  )
fi
(
  cd "$repo_root"
  env \
    CGO_ENABLED=1 \
    MACOSX_DEPLOYMENT_TARGET="$deployment_target" \
    CGO_CFLAGS="${CGO_CFLAGS:-} -mmacosx-version-min=$deployment_target" \
    CGO_LDFLAGS="${CGO_LDFLAGS:-} -mmacosx-version-min=$deployment_target" \
    GOFLAGS="${GOFLAGS:--tags=sqlite_fts5}" \
    "${go_command[@]}" -C trawl build \
    -trimpath \
    -ldflags "-X github.com/opentrawl/opentrawl/trawl/internal/cli.Version=$version -X github.com/opentrawl/opentrawl/trawl/internal/cli.BuildCommit=$commit -X github.com/opentrawl/opentrawl/trawlkit.buildVersion=$version -X github.com/opentrawl/opentrawl/trawlkit.buildCommit=$commit" \
    -o "$contents/Helpers/trawl" \
    ./cmd/trawl
)
chmod +x "$contents/MacOS/OpenTrawlApp" "$contents/Helpers/trawl"

sparkle_framework="$(find "$swift_scratch/artifacts" -type d \
  -path '*/macos-arm64_x86_64/Sparkle.framework' -print -quit)"
if [[ -z "$sparkle_framework" ]]; then
  echo "dev-run: SwiftPM did not produce Sparkle.framework" >&2
  exit 1
fi
ditto "$sparkle_framework" "$contents/Frameworks/Sparkle.framework"
mkdir -p "$build_root"
cp "$photos_entitlements" "$dev_entitlements"
/usr/libexec/PlistBuddy \
  -c "Add :com.apple.security.cs.disable-library-validation bool true" \
  "$dev_entitlements"

# The Nix Go toolchain may record its own resolver path. The bundled CLI uses
# the equivalent macOS platform library so it runs outside the dev shell.
if file "$contents/Helpers/trawl" | grep -q 'Mach-O'; then
  nix_resolver="$(otool -L "$contents/Helpers/trawl" \
    | sed -n 's#^[[:space:]]*\(/nix/store/[^ ]*/libresolv\.9\.dylib\).*#\1#p' \
    | head -1)"
  if [[ -n "$nix_resolver" ]]; then
    install_name_tool -change "$nix_resolver" /usr/lib/libresolv.9.dylib \
      "$contents/Helpers/trawl"
  fi
fi

echo "Compiling the app icon"
xcrun actool \
  --output-format human-readable-text \
  --notices \
  --warnings \
  --platform macosx \
  --minimum-deployment-target "$deployment_target" \
  --target-device mac \
  --app-icon OpenTrawl \
  --output-partial-info-plist "$build_root/icon-info.plist" \
  --compile "$contents/Resources" \
  "$repo_root/assets/brand/OpenTrawl.icon"

info="$contents/Info.plist"
plutil -create xml1 "$info"
plutil -insert CFBundleDevelopmentRegion -string en "$info"
plutil -insert CFBundleDisplayName -string OpenTrawl "$info"
plutil -insert CFBundleExecutable -string OpenTrawlApp "$info"
plutil -insert CFBundleIconName -string OpenTrawl "$info"
plutil -insert CFBundleIdentifier -string org.opentrawl.trawl "$info"
plutil -insert CFBundleName -string OpenTrawl "$info"
plutil -insert CFBundlePackageType -string APPL "$info"
plutil -insert CFBundleShortVersionString -string "$version" "$info"
plutil -insert CFBundleVersion -string 1 "$info"
plutil -insert GitCommit -string "$commit" "$info"
plutil -insert GitDirty -bool "$dirty" "$info"
plutil -insert LSApplicationCategoryType -string public.app-category.utilities "$info"
plutil -insert LSMinimumSystemVersion -string "$deployment_target" "$info"
plutil -insert NSHighResolutionCapable -bool true "$info"
plutil -insert NSPhotoLibraryUsageDescription -string "OpenTrawl reads your photo library on this Mac so you can search your photos." "$info"
plutil -insert CFBundleDocumentTypes -xml '<array><dict><key>CFBundleTypeName</key><string>OpenTrawl Photos media request</string><key>CFBundleTypeRole</key><string>Viewer</string><key>LSHandlerRank</key><string>Owner</string><key>LSItemContentTypes</key><array><string>org.opentrawl.photos-media-request</string></array></dict></array>' "$info"
plutil -insert UTExportedTypeDeclarations -xml '<array><dict><key>UTTypeIdentifier</key><string>org.opentrawl.photos-media-request</string><key>UTTypeConformsTo</key><array><string>public.data</string></array><key>UTTypeDescription</key><string>OpenTrawl Photos media request</string><key>UTTypeTagSpecification</key><dict><key>public.filename-extension</key><array><string>opentrawl-photos-media-request</string></array></dict></dict></array>' "$info"
plutil -insert SUEnableAutomaticChecks -bool false "$info"

echo "Signing the local app"
"$repo_root/scripts/dev-cert"
security unlock-keychain -p "$(<"$pass_file")" "$keychain"
xattr -cr "$app"
sparkle="$contents/Frameworks/Sparkle.framework"
codesign --force --sign "$identity" --keychain "$keychain" \
  --options runtime --timestamp=none "$sparkle/Versions/B/XPCServices/Installer.xpc"
codesign --force --sign "$identity" --keychain "$keychain" \
  --options runtime --timestamp=none --preserve-metadata=entitlements \
  "$sparkle/Versions/B/XPCServices/Downloader.xpc"
codesign --force --sign "$identity" --keychain "$keychain" \
  --options runtime --timestamp=none "$sparkle/Versions/B/Autoupdate"
codesign --force --sign "$identity" --keychain "$keychain" \
  --options runtime --timestamp=none "$sparkle/Versions/B/Updater.app"
codesign --force --sign "$identity" --keychain "$keychain" \
  --options runtime --timestamp=none "$sparkle"
codesign --force --sign "$identity" --keychain "$keychain" \
  --options runtime --timestamp=none \
  --identifier org.opentrawl.trawl \
  --entitlements "$photos_entitlements" \
  "$contents/Helpers/trawl"
codesign --force --sign "$identity" --keychain "$keychain" \
  --options runtime --timestamp=none --entitlements "$dev_entitlements" \
  "$contents/MacOS/OpenTrawlApp"
codesign --force --sign "$identity" --keychain "$keychain" \
  --options runtime --timestamp=none --entitlements "$dev_entitlements" "$app"
codesign --verify --deep --strict "$app"
codesign -dvvv "$app" 2>&1 | grep -F "Authority=$identity" >/dev/null
[[ "$(codesign -d -r- "$contents/Helpers/trawl" 2>&1)" == *'identifier "org.opentrawl.trawl"'* ]]
expected_cli_identity="OpenTrawl $version
Commit $commit"
[[ "$($contents/Helpers/trawl --version)" == "$expected_cli_identity" ]]
app_entitlements="$(mktemp "${TMPDIR:-/tmp}/opentrawl-dev-entitlements.XXXXXX")"
trap 'trash "$app_entitlements"' EXIT
codesign --display --entitlements - "$app" >"$app_entitlements" 2>/dev/null
grep -F -A 3 '[Key] com.apple.security.personal-information.photos-library' "$app_entitlements" \
  | grep -F '[Bool] true' >/dev/null

if [[ -n "$candidate_name" ]]; then
  mv "$staging_root" "$candidate_directory"
  app="$candidate_app"
fi
echo "Built $app"
if [[ "$launch" -eq 1 ]]; then
  open -n "$app"
fi
