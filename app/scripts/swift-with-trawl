#!/usr/bin/env bash
set -euo pipefail

# OPENTRAWL_GOOGLE_OAUTH_CLIENT_SECRET_FILE names a file holding only the
# Google desktop OAuth client secret. A build without it cannot connect
# Gmail. The secret goes into the Go archive and is never printed.

app_directory="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
archive_directory="$(mktemp -d "${TMPDIR:-/tmp}/opentrawl-go-archive.XXXXXX")"
trap '/bin/rm -rf "$archive_directory"' EXIT
command_line_archive="$archive_directory/libOpenTrawlCommandLine.a"
go_linker_flag_values=()
if [[ -n "${OPENTRAWL_BUILD_VERSION:-}" ]]; then
  go_linker_flag_values+=(-s -w
    "-X github.com/opentrawl/opentrawl/trawl/internal/cli.Version=$OPENTRAWL_BUILD_VERSION"
    "-X github.com/opentrawl/opentrawl/trawlkit.buildVersion=$OPENTRAWL_BUILD_VERSION")
fi
if [[ -n "${OPENTRAWL_GOOGLE_OAUTH_CLIENT_SECRET_FILE:-}" ]]; then
  [[ -s "$OPENTRAWL_GOOGLE_OAUTH_CLIENT_SECRET_FILE" ]] || {
    echo "swift-with-trawl: Google OAuth client secret file is missing or empty" >&2
    exit 1
  }
  google_oauth_client_secret="$(tr -d '\r\n' < "$OPENTRAWL_GOOGLE_OAUTH_CLIENT_SECRET_FILE")"
  [[ "$google_oauth_client_secret" =~ ^[A-Za-z0-9_-]+$ ]] || {
    echo "swift-with-trawl: Google OAuth client secret has an invalid format" >&2
    exit 1
  }
  go_linker_flag_values+=("-X github.com/opentrawl/opentrawl/gmail.DefaultGoogleOAuthClientSecret=$google_oauth_client_secret")
fi
go_linker_flags=()
if [[ "${#go_linker_flag_values[@]}" -gt 0 ]]; then
  go_linker_flags=(-ldflags "${go_linker_flag_values[*]}")
fi

echo "Building the Go CLI archive"
CGO_ENABLED=1 \
  MACOSX_DEPLOYMENT_TARGET=26.0 \
  CGO_CFLAGS="${CGO_CFLAGS:-} -mmacosx-version-min=26.0" \
  CGO_LDFLAGS="${CGO_LDFLAGS:-} -mmacosx-version-min=26.0" \
  GOFLAGS="${GOFLAGS:--tags=sqlite_fts5}" \
  go -C "$app_directory/../trawl" build -trimpath -buildmode=c-archive \
    ${go_linker_flags[@]+"${go_linker_flags[@]}"} \
    -o "$command_line_archive" ./cmd/trawl-clib

# A fresh archive path makes SwiftPM relink when only the Go code changes.
swift_environment=(HOME="${HOME:-/tmp}" PATH="/usr/bin:/bin:/usr/sbin:/sbin")
if [[ "${OPENTRAWL_SKIP_WINDOW_FOCUS_TESTS:-}" == "1" ]]; then
  swift_environment+=(OPENTRAWL_SKIP_WINDOW_FOCUS_TESTS=1)
fi
if [[ -n "${OPENTRAWL_PLUGIN_DIRS:-}" ]]; then
  swift_environment+=("OPENTRAWL_PLUGIN_DIRS=$OPENTRAWL_PLUGIN_DIRS")
fi
/usr/bin/env -i "${swift_environment[@]}" \
  /usr/bin/xcrun swift "$@" --package-path "$app_directory" -Xlinker "$command_line_archive"
