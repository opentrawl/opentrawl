#!/bin/sh
set -eu

trawler=
limit=20

while [ "$#" -gt 0 ]; do
	case "$1" in
		--trawler)
			trawler=${2-}
			shift 2
			;;
		--limit)
			limit=${2-}
			shift 2
			;;
		--help)
			printf '%s\n' 'usage: search [--trawler NAME] [--limit N] QUERY'
			exit 0
			;;
		--*)
			printf 'unknown option: %s\n' "$1" >&2
			exit 2
			;;
		*)
			break
			;;
	esac
done

if [ "$#" -eq 0 ]; then
	printf '%s\n' 'QUERY is required' >&2
	exit 2
fi

query=$*
corpus=${TRAWL_SEMANTIC_CORPUS:?TRAWL_SEMANTIC_CORPUS is required}
semantic_vectors=${TRAWL_SEMANTIC_VECTORS:?TRAWL_SEMANTIC_VECTORS is required}
search_command=${TRAWL_SEARCH_COMMAND:?TRAWL_SEARCH_COMMAND is required}

printf '%s\n' 'Candidates'
set -- search --corpus "$corpus" --vectors "$semantic_vectors" --limit "$limit"
if [ -n "$trawler" ]; then
	set -- "$@" --trawler "$trawler"
fi
"$search_command" "$@" "$query"
