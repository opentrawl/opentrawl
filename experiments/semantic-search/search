#!/bin/sh
set -eu

retrieval=
trawler=
limit=20

while [ "$#" -gt 0 ]; do
	case "$1" in
		--retrieval)
			retrieval=${2-}
			shift 2
			;;
		--trawler)
			trawler=${2-}
			shift 2
			;;
		--limit)
			limit=${2-}
			shift 2
			;;
		--help)
			printf '%s\n' 'usage: search --retrieval lexical|hybrid [--trawler NAME] [--limit N] QUERY'
			exit 0
			;;
		--*)
			printf 'unknown option: %s\n' "$1" >&2
			exit 2
			;;
		*)
			break
			;;
	esac
done

if [ "$retrieval" != lexical ] && [ "$retrieval" != hybrid ]; then
	printf '%s\n' '--retrieval must be lexical or hybrid' >&2
	exit 2
fi
if [ "$#" -eq 0 ]; then
	printf '%s\n' 'QUERY is required' >&2
	exit 2
fi

query=$*
corpus=${TRAWL_SEMANTIC_CORPUS:?TRAWL_SEMANTIC_CORPUS is required}
manifest=${TRAWL_SEMANTIC_MANIFEST:?TRAWL_SEMANTIC_MANIFEST is required}
lexical_search=${TRAWL_LEXICAL_SEARCH:?TRAWL_LEXICAL_SEARCH is required}

printf '%s\n' 'Lexical candidates'
lexical_limit=$limit
semantic_limit=0
if [ "$retrieval" = hybrid ]; then
	lexical_limit=$(((limit + 1) / 2))
	semantic_limit=$((limit / 2))
fi

set +e
set -- search-lexical --corpus "$corpus" --manifest "$manifest" --limit "$lexical_limit"
if [ -n "$trawler" ]; then
	set -- "$@" --trawler "$trawler"
fi
lexical_output=$("$lexical_search" "$@" "$query" 2>&1)
lexical_status=$?
set -e
printf '%s\n' "$lexical_output"
if [ "$lexical_status" -ne 0 ]; then
	exit "$lexical_status"
fi

if [ "$retrieval" = lexical ]; then
	exit 0
fi

printf '\n%s\n' 'Semantic candidates'
semantic_search=${TRAWL_SEMANTIC_SEARCH:?TRAWL_SEMANTIC_SEARCH is required}
semantic_vectors=${TRAWL_SEMANTIC_VECTORS:?TRAWL_SEMANTIC_VECTORS is required}
semantic_ledger=${TRAWL_SEMANTIC_LEDGER:?TRAWL_SEMANTIC_LEDGER is required}
semantic_endpoint=${TRAWL_SEMANTIC_ENDPOINT-http://127.0.0.1:8081}
lexical_links=$(printf '%s\n' "$lexical_output" | sed -n 's/.* \([a-z][a-z]*:[a-z0-9][a-z0-9]*\)$/\1/p' | paste -sd, -)
lexical_result_count=$(printf '%s\n' "$lexical_links" | awk -F, 'NF == 1 && $1 == "" { print 0; next } { print NF }')
semantic_limit=$((limit - lexical_result_count))
if [ "$semantic_limit" -le 0 ]; then
	exit 0
fi

set -- --corpus "$corpus" --manifest "$manifest" --ledger "$semantic_ledger" search-query \
	--index "$semantic_vectors" --endpoint "$semantic_endpoint" --limit "$semantic_limit"
if [ -n "$trawler" ]; then
	set -- "$@" --trawler "$trawler"
fi
if [ -n "$lexical_links" ]; then
	old_ifs=$IFS
	IFS=,
	for lexical_link in $lexical_links; do
		set -- "$@" --exclude-link "$lexical_link"
	done
	IFS=$old_ifs
fi
"$semantic_search" "$@" "$query"
